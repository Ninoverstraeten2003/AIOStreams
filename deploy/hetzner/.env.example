# Copy to .env on the server and fill in. Everything not here is a runtime
# setting, best changed from the dashboard (Settings) after the first start.

# Hostname Traefik routes to this container. Needs a DNS record pointing at the server.
AIOSTREAMS_HOST=aiostreams.ninoverstraeten.com
BASE_URL=https://aiostreams.ninoverstraeten.com

# 64 hex characters: openssl rand -hex 32
# Never change it after the first start: stored configurations can't be decrypted without it.
SECRET_KEY=

DATABASE_URI=sqlite://./data/db.sqlite

# Accounts for this instance, as user:password pairs separated by commas.
# Users not listed in AIOSTREAMS_AUTH_PERMISSIONS are admins.
AIOSTREAMS_AUTH=
# Only signed-in users may open the configure page and create configurations.
AIOSTREAMS_AUTH_REQUIRED=true

LOG_FORMAT=json
